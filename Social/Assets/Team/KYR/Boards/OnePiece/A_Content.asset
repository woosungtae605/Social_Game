  m_Script: {fileID: 11500000, guid: a8c7d6e5f4b33210a9c8d7e6f5a4b3c2, type: 3}
  m_Name: A_Content
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "\uBBF8\uD638\uD06C\uAC00 \uC0F9\uD06C\uC2A4\uBCF4\uB2E4 \uAC15\uD558\uB2E4\uB294
    \uB188\uB4E4\uC740 \uB9CC\uD654\uB97C \uB300\uCCB4 \uC5B4\uB514\uB85C \uBCF8\uAC70\uC784?\r\n\r\n\uC77C\uB2E8
    \uC0F9\uD06C\uC2A4\uB294 \uC0AC\uD669\uC784\u3147\u3147\r\n\uBBF8\uD638\uD06C\uB294
    \uC138\uCD5C\uAC80\uC774\uACE0 \uC0F9\uD06C\uC2A4\uB294 \uAC80\uC0AC\uB2C8\uAE4C
    \uBBF8\uD638\uD06C\uAC00 \uC704\uB2E4?\r\n\uC774 \uB17C\uB9AC\uBA74 \uAC80\uC0AC\uC778
    \uC870\uB85C\uAC00 \uC0AC\uD669\uAE09\uC774\uB77C\uB294 \uC18C\uB9AC\uB3C4 \uD574\uC57C\uC9C0\u314B\u314B\r\n\r\n\uADF8\uB9AC\uACE0
    \uBBF8\uD638\uD06C\uAC00 \uC0F9\uD06C\uC2A4\uBCF4\uB2E4 \uAC15\uD588\uC73C\uBA74
    \uC815\uC0C1\uC804\uC7C1 \uB54C \uC65C \uADF8\uB807\uAC8C \uC874\uC7AC\uAC10\uC774
    \uC5C6\uC5C8\uACA0\uC74C\r\n\uC0F9\uD06C\uC2A4\uB294 \uB4F1\uC7A5\uD558\uC790\uB9C8\uC790
    \uC804\uC7C1 \uB05D\uB0B4\uBC84\uB9AC\uACE0 \uD574\uAD70\uAE4C\uC9C0 \uB208\uCE58
    \uBCF4\uAC8C \uB9CC\uB4E4\uC5C8\uB294\uB370\r\n\uBBF8\uD638\uD06C\uB294 \uBE44\uC2A4\uD0C0\uB791
    \uC2F8\uC6B0\uB2E4\uAC00 \uBB50\uD568?\r\n\r\n\uACB0\uAD6D \uC791\uC911 \uBB18\uC0AC\uBD80\uD130\uAC00
    \uB2E4\uB984\r\n\r\n\uC0F9\uD06C\uC2A4 = \uD328\uC655\uC0C9\uC73C\uB85C \uC8FC\uBCC0
    \uC555\uB3C4 + \uC0AC\uD669 + \uB85C\uC800 \uD574\uC801\uB2E8 \uCD9C\uC2E0 +
    \uD0A4\uB4DC \uC6D0\uCF64\r\n\uBBF8\uD638\uD06C = \uC138\uCD5C\uAC80 \uD0C0\uC774\uD2C0
    + \uC870\uB85C \uCD5C\uC885\uBAA9\uD45C\r\n\r\n\uC560\uCD08\uC5D0 \uC791\uAC00\uAC00
    \uC0F9\uD06C\uC2A4\uB97C \uADF8\uB0E5 \uAC80\uC220\uCE90\uB85C\uB9CC \uADF8\uB838\uC73C\uBA74
    \uBAB0\uB77C\uB3C4\r\n\uD328\uC655\uC0C9\uBD80\uD130 \uC2DC\uC791\uD574\uC11C
    \uC0AC\uD669\uC73C\uB85C\uC11C\uC758 \uC704\uC0C1\uAE4C\uC9C0 \uACC4\uC18D \uB530\uB85C
    \uBCF4\uC5EC\uC8FC\uB294\uB370\r\n\r\n\"\uAC80 \uB4E4\uACE0 \uC788\uC73C\uB2C8\uAE4C
    \uBBF8\uD638\uD06C\uAC00 \uBB34\uC870\uAC74 \uC704\"\r\n\uC774\uAC74 \uADF8\uB0E5
    \uCE6D\uD638 \uD558\uB098 \uBD99\uC7A1\uACE0 \uB9CC\uD654 \uBCF4\uB294 \uAC70\uC784\u3147\u3147\r\n\r\n\uADF8\uB9AC\uACE0
    \uB458\uC774 \uACFC\uAC70\uC5D0 \uACB0\uD22C\uD588\uB2E4\uB294 \uC124\uC815\uAE4C\uC9C0
    \uC788\uB294\uB370\r\n\uC0F9\uD06C\uC2A4 \uD314 \uD558\uB098 \uC5C6\uC5B4\uC84C\uB2E4\uACE0
    \uBBF8\uD638\uD06C\uAC00 \uAC11\uC790\uAE30 \uC555\uB3C4\uC801\uC778 \uC0C1\uC704\uD638\uD658
    \uB418\uB294 \uAC83\uB3C4 \uC544\uB2C8\uACE0\u314B\u314B\r\n\r\n\uC0F9\uD06C\uC2A4\uB294
    \uADF8\uB0E5 \uC0F9\uD06C\uC2A4\uC784\r\n\uBBF8\uD638\uD06C\uB791 \uBE44\uAD50\uD560
    \uB54C\uB9C8\uB2E4 \uC65C \uC790\uAFB8 \uC138\uCD5C\uAC80 \uD558\uB098\uB85C
    \uB05D\uB0B4\uB824\uACE0 \uD558\uB294\uC9C0 \uBAA8\uB974\uACA0\uC74C\r\n\r\n\uC0F9\uBE60
    \uC785\uC7A5\uC5D0\uC120 \uCD5C\uC885\uC801\uC73C\uB85C\r\n**\uC0F9\uD06C\uC2A4
    \u2265 \uBBF8\uD638\uD06C**\r\n\uC774\uAC8C \uC81C\uC77C \uD569\uB9AC\uC801\uC774\uB77C\uACE0
    \uBD04\u3147\u3147\r\n"
  images: []
