  m_Script: {fileID: 11500000, guid: a8c7d6e5f4b33210a9c8d7e6f5a4b3c2, type: 3}
  m_Name: Tea_Tip_Content
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "\uCC28 \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC73C\uB85C\uC11C \uAC04\uB2E8\uD55C
    \uD301 \uBA87 \uAC1C \uC801\uC5B4\uBD04 hhhh\r\n\r\n\uB179\uCC28\uB294 \uBB3C
    \uB108\uBB34 \uB728\uAC81\uAC8C \uD558\uC9C0 \uB9C8\uC148.\r\n\uC870\uAE08 \uC2DD\uD600\uC11C
    \uC6B0\uB9AC\uBA74 \uC4F4\uB9DB \uB35C\uD558\uACE0 \uD5A5\uB3C4 \uD6E8\uC52C
    \uC88B\uC74C~\r\n\r\n\uC6B0\uB871\uCC28\uB098 \uBCF4\uC774\uCC28\uB294 \uB728\uAC70\uC6B4
    \uBB3C \uC4F0\uB294 \uAC8C \uC88B\uACE0,\r\n\uC624\uB798 \uC6B0\uB9AC\uAE30\uBCF4\uB2E4\uB294
    \uC9E7\uAC8C \uC5EC\uB7EC \uBC88 \uC6B0\uB9AC\uB294 \uAC78 \uCD94\uCC9C\uD568.\r\n\r\n\uADF8\uB9AC\uACE0
    \uBCF4\uC774\uCC28\uB098 \uC6B0\uB871\uCC28\uB294 \uCCAB \uBB3C \uD55C\uBC88
    \uBC84\uB9AC\uACE0 \uB9C8\uC154\uB3C4 \uC88B\uC74C.\r\n\uCC3B\uC78E\uC774 \uD3B4\uC9C0\uBA74\uC11C
    \uB450 \uBC88\uC9F8\uBD80\uD130 \uB9DB\uC774 \uC81C\uB300\uB85C \uB098\uC634
    \r\n\r\n\uCC28\uB294 \uB0C4\uC0C8\uB3C4 \uC798 \uD761\uC218\uD558\uB2C8\uAE4C
    \uBCF4\uAD00\uD560 \uB54C \uCEE4\uD53C\uB098 \uD5A5\uC2E0\uB8CC \uC606\uC5D0\uB294
    \uB450\uC9C0 \uB9C8\uC148\u314B\u314B\r\n\r\n\uC774 \uC815\uB3C4\uB9CC \uC54C\uC544\uB3C4
    \uCC28 \uB9DB\uC774 \uAF64 \uB2EC\uB77C\uC9C8 \uAC70\uC784.\r\n\r\n666 \uC815\uBCF4
    \uACF5\uC720 \uB3C4\uC6C0 \uB410\uC73C\uBA74 \uC0BC\uB828 \uD55C\uBC88 \uBD80\uD0C1\uD568
    \r\n\uC88B\uC544\uC694\uB791 \uB3D9\uC804, \uC990\uACA8\uCC3E\uAE30 \uD574\uC8FC\uBA74
    \uB2E4\uC74C\uC5D0\uB3C4 \uCC28 \uC598\uAE30 \uAC00\uC838\uC624\uACA0\uC74C~"
  images: []
