  m_Script: {fileID: 11500000, guid: a8c7d6e5f4b33210a9c8d7e6f5a4b3c2, type: 3}
  m_Name: Indo_1_content
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "\uC778\uB3C4\uC5D0 \uB300\uD574 \uC54C\uACE0 \uC2F6\uB2E4\uBA74 \uD06C\uB9AC\uCF13
    \uACBD\uAE30\uB97C \uD55C\uBC88 \uBCF4\uC138\uC694.\r\n\r\n\uC9C4\uC9DC\uB85C,
    \uC5EC\uAE30\uC11C\uB294 \uC5B4\uB514\uC5D0 \uAC00\uB4E0 \uD06C\uB9AC\uCF13\uC5D0
    \uB300\uD574 \uC774\uC57C\uAE30\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uCE5C\uAD6C\uB4E4\uACFC
    \uC788\uC744 \uB54C\uB3C4, \uAC00\uC871\uB4E4\uACFC \uC788\uC744 \uB54C\uB3C4,
    \uAC00\uAC8C\uC5D0 \uC788\uC744 \uB54C\uB3C4\r\n\uACBD\uAE30\uAC00 \uC2DC\uC791\uD558\uBA74
    \uBAA8\uB450\uAC00 \uAC19\uC740 \uACBD\uAE30\uB97C \uBCF4\uACE0 \uC774\uC57C\uAE30\uD569\uB2C8\uB2E4.\r\n\r\n\uD2B9\uD788
    \uC778\uB3C4 \uACBD\uAE30\uAC00 \uC788\uB294 \uB0A0\uC5D0\uB294\r\n\uB098\uB77C
    \uC804\uCCB4\uAC00 \uD568\uAED8 \uACBD\uAE30\uB97C \uBCF4\uACE0 \uC788\uB294
    \uAC83 \uAC19\uC740 \uB290\uB08C\uC774 \uB4ED\uB2C8\uB2E4.\r\n\r\n\uADDC\uCE59\uC744
    \uBAA8\uB450 \uC54C \uD544\uC694\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uBA87 \uC624\uBC84\uB9CC
    \uBCF4\uACE0 \uC788\uC5B4\uB3C4 \uC0AC\uB78C\uB4E4\uC774 \uC65C \uC774\uB807\uAC8C
    \uC88B\uC544\uD558\uB294\uC9C0 \uC54C\uAC8C \uB420 \uAC81\uB2C8\uB2E4.\r\n\r\n\uC778\uB3C4\uC5D0\uC11C
    \uD06C\uB9AC\uCF13\uC740 \uB2E8\uC21C\uD55C \uC2A4\uD3EC\uCE20\uAC00 \uC544\uB2D9\uB2C8\uB2E4.\r\n\uC6B0\uB9AC
    \uBB38\uD654\uC758 \uD070 \uBD80\uBD84\uC785\uB2C8\uB2E4."
  images:
  - {fileID: 2006618705864850237, guid: 633a364bb8c54d74aa569759ccca42ec, type: 3}
