  m_Script: {fileID: 11500000, guid: a8c7d6e5f4b33210a9c8d7e6f5a4b3c2, type: 3}
  m_Name: Content_CC_M
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "\uCE6D\uAE30\uC988\uCE78\uC774 \uBD80\uD558\uC778 \uC81C\uBC30, \uC218\uBD80\uD0C0\uC774,
    \uBB34\uCE74\uB9AC \uB4F1\uC744 \uC774\uB04C\uACE0 \uC11C\uD558, \uC11C\uC694,
    \uD638\uB77C\uC998, \uAE08\uB098\uB77C, \uD0A4\uC608\uD504 \uB8E8\uC2DC\uB4F1\uC744
    \uC0C1\uB300\uB85C \uC2F8\uC6B0\uBA74\uC11C \uC601\uD1A0\uD655\uC7A5 \uD558\uB294\uB370 
    \uC11C\uC544\uC2DC\uC544\uB791 \uC911\uB3D9, \uCE85\uCE74\uC2A4 \uC9C0\uC5ED,
    \uB7EC\uC2DC\uC544, \uD3F4\uB780\uB4DC, \uD5DD\uAC00\uB9AC\uC5D0\uC11C\uB294
    \uCE6D\uAE30\uC988\uCE78\uC744 \uC794\uC778\uD55C \uD559\uC0B4\uC790\uB77C\uACE0
    \uBE44\uB09C\uD558\uB358\uB370 \uC804\uD22C\uC5D0\uC11C \uC9C4 \uAC70 \uAC19\uACE0
    \uB108\uBB34 \uCC0C\uC9C8\uD558\uAC8C \uAD6C\uB294 \uAC70 \uC544\uB2D8?\r\n\r\n\r\n\r\n\uCE6D\uAE30\uC988\uCE78\uD558\uACE0
    \uC218\uBD80\uD0C0\uC774\uB294 \uD55C\uB54C \uC758\uD615\uC81C\uC778 \uC7C8\uBB34\uCE74,
    \uC774\uC2AC\uB78C \uC885\uAD50 \uC9C0\uB3C4\uC790 \uCE7C\uB9AC\uD504, \uD0A4\uC608\uD504
    \uB8E8\uC2DC\uC758 \uADC0\uC871\uB4E4\uACFC \uB300\uACF5\uB4E4\uC744 \uB9D0\uBC1C\uAD7D\uC73C\uB85C
    \uBC1F\uC544 \uC8FD\uC774\uB294 \uD53C\uB97C \uD758\uB9AC\uC9C0 \uC54A\uB294
    \uBA85\uC608\uB85C\uC6B4 \uC8FD\uC74C\uC744 \uC120\uC0AC\uD560 \uC815\uB3C4\uB85C
    \uB300\uC778\uBC30\uB77C\uACE0 \uB4E4\uC5C8\uB294\uB370\r\n\r\n\r\n\r\n\uC57C\uB9CC\uC871\uC774\uB780
    \uC18C\uB9AC\uB294 \uC624\uD788\uB824 \uD638\uB77C\uC998\uC774\uB098 \uD0A4\uC608\uD504
    \uB8E8\uC2DC\uAC00 \uD574\uB2F9\uB418\uB294\uAC70 \uC544\uB2D8? "
  images: []
