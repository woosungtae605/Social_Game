  m_Name: 1_E
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "\uC6B0\uC120 \uC4F0\uB2C8\uB294 \uD3C9\uBC1C\uB85C \uC9C0\uD558\uCCA0 \uACF5\uC775
    \uAC04 \uC0AC\uB78C\uC784\u3147\u3147\n\uADF8\uB798\uC11C \uBAA8\uB4E0 \uAC78
    \uB2E4 \uC544\uB294 \uAC74 \uC544\uB2CC\uB370 \uD55C 1\uAC1C\uC6D4 \uC815\uB3C4
    \uD558\uBA74\uC11C \uB290\uB080 \uC810 \uBA87 \uAC1C \uC801\uC5B4\uBD04\n\n1.
    \uC804\uC7A5\uC5F0 <- \uC774 \uC0AC\uB78C\uB4E4\uC740 \u3139\u3147 \uC2E0\uC784\u3147\u3147\n\uC598\uB124
    \uC624\uBA74 \uAD1C\uD788 \uBB50 \uD558\uB824\uACE0 \uD558\uC9C0 \uB9D0\uACE0
    \uADF8\uB0E5 \uAC00\uB9CC\uD788 \uC788\uC73C\uBA74 \uB428\n\uD558\uB8E8 \uC2A4\uD0B5\uAD8C
    \uB4E4\uACE0 \uC624\uC2DC\uB294 \uBD84\uB4E4\uC784\n2. \uC911\uAC04\uC911\uAC04
    \uAC01 \uC798 \uC7AC\uB2E4\uAC00 \uB2F4\uBC30 \uD53C\uB7EC \uAC04\uB2E4\uACE0
    \uD558\uACE0 \uB098\uAC00\uBA74 \uC0DD\uAC01\uBCF4\uB2E4 \uC2DC\uAC04 \uC798
    \uAC10\n\uBB3C\uB860 \uB108\uBB34 \uD2F0 \uB098\uAC8C \uD558\uBA74 \uC548 \uB418\uACE0
    \uB208\uCE58\uAECF \uD574\uC57C \uB428\u3147\u3147\n3. \uACF5\uC775 \uC637 <-
    \uB300\uCCB4 \uB204\uAC00 \uB514\uC790\uC778\uD55C \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370\n\uC774\uAC74
    \u3139\u3147 \uB4B7\uB3C8 \uBC1B\uC740 \uC0AC\uB78C \uC788\uB294 \uAC70 \uC544\uB2CC\uAC00
    \uC2F6\uC74C\n\uC785\uB294 \uC21C\uAC04 \uC778\uAC04 \uC874\uC5C4\uC131\uC774
    \uD55C \uB2E8\uACC4 \uB0B4\uB824\uAC10\n4. \uC9C0\uD558\uCCA0 \uACF5\uC775 \uC0DD\uAC01\uBCF4\uB2E4
    \uD560 \uAC70 \uC5C6\uC74C\n\uCC98\uC74C\uC5D0\uB294 \uC2DC\uAC04 \uC874\uB098
    \uC548 \uAC00\uB294\uB370 \uC801\uC751\uD558\uBA74 \uADF8\uB0E5 \uC2DC\uBBAC\uB808\uC774\uC158
    \uAC8C\uC784\uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD558\uBA74 \uB428\n\uC624\uB298\uB3C4
    \uBB34\uC0AC\uD788 \uD1F4\uADFC\uD55C\uB2E4\uB294 \uB9C8\uC778\uB4DC\uB85C \uBC84\uD2F0\uBA74
    \uB428\u3147\u3147\n\n\uC544\uC9C1 1\uAC1C\uC6D4\uCC28\uB77C \uB0B4\uAC00 \uBAA8\uB974\uB294
    \uAC83\uB3C4 \uB9CE\uC74C\n\uADF8\uB798\uB3C4 \uC9C0\uD558\uCCA0 \uACF5\uC775
    \uAC00\uB294 \uC9C0\uBD95\uC774\uB4E4 \uC788\uC73C\uBA74 \uB108\uBB34 \uCAC4
    \uD544\uC694\uB294 \uC5C6\uB2E4\uACE0 \uB9D0\uD574\uC8FC\uACE0 \uC2F6\uB2E4\n\n\uB2E4\uB4E4
    \uBAB8 \uAC74\uAC15\uD558\uAC8C \uBCF5\uBB34\uD558\uACE0 \uBB34\uC0AC\uD788 \uC18C\uC9D1\uD574\uC81C\uD558\uC148\u3147\u3147"
