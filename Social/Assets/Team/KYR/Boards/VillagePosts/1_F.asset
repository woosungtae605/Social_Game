  m_Name: 1_F
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "20\uB300\uB791 50\uB300 \uC11C\uB85C \uB108\uBB34 \uBBF8\uC6CC\uD560 \uD544\uC694\uB294
    \uC5C6\uB294 \uAC83 \uAC19\uC74C\u3147\u3147\n\n20\uB300 \uC785\uC7A5\uC5D0\uC11C\uB294\n\"\uC694\uC998
    \uC138\uB300\uB294 \uC65C \uC774\uB7EC\uB0D0\" \uC774\uB7F0 \uC18C\uB9AC \uB4E4\uC73C\uBA74
    \uAC1C\uBE61\uCE58\uB294 \uAC70 \uC774\uD574\uD558\uACE0\n\n50\uB300 \uC785\uC7A5\uC5D0\uC11C\uB3C4\n\"\uC6B0\uB9AC\uAC00
    \uC0B4\uC544\uC628 \uC2DC\uB300\uB791 \uC9C0\uAE08\uC774 \uB108\uBB34 \uB2E4\uB978\uB370
    \uC65C \uC6B0\uB9AC\uB97C \uC774\uD574 \uBABB\uD574\uC8FC\uB0D0\" \uD558\uB294
    \uAC83\uB3C4 \uC774\uD574\uB428\n\n\uADFC\uB370 \uC194\uC9C1\uD788 \uC11C\uB85C
    \uC0B4\uC544\uC628 \uD658\uACBD \uC790\uCCB4\uAC00 \uB2E4\uB978\uB370\n\uC0C1\uB300\uBC29\uD55C\uD14C
    \uC790\uAE30 \uAE30\uC900 \uADF8\uB300\uB85C \uB4E4\uC774\uB300\uB2C8\uAE4C \uB9E8\uB0A0
    \uC2F8\uC6B0\uB294 \uAC83 \uAC19\uC74C\n\n20\uB300\uB294 50\uB300\uAC00 \uAF30\uB300\uB77C\uACE0
    \uBB34\uC870\uAC74 \uC0DD\uAC01\uD558\uC9C0 \uB9D0\uACE0\n50\uB300\uB3C4 20\uB300\uAC00
    \uB098\uC57D\uD558\uB2E4\uB290\uB2C8 \uC694\uC998 \uC560\uB4E4\uC740 \uC774\uAE30\uC801\uC774\uB77C\uB290\uB2C8
    \uC2F8\uC7A1\uC544 \uB9D0\uD558\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uC74C\n\n\uC5B4\uCC28\uD53C
    20\uB300\uB3C4 \uB098\uC774 \uBA39\uC5B4\uC11C 50\uB300 \uB420 \uAC70\uACE0\n\uC9C0\uAE08
    50\uB300\uB3C4 \uD55C\uB54C\uB294 20\uB300\uC600\uC74C\u3147\u3147\n\n\uC11C\uB85C
    \uC870\uAE08\uC529 \uC774\uD574\uD558\uACE0\n\"\uC544 \uC598\uB124\uB294 \uC800\uB7F0
    \uC2DC\uB300\uC5D0\uC11C \uC0B4\uC544\uC654\uAD6C\uB098\" \uC815\uB3C4\uB9CC
    \uC0DD\uAC01\uD574\uB3C4 \uD6E8\uC52C \uD3B8\uD574\uC9C8 \uB4EF\n\n\uC138\uB300\uAC00
    \uB2E4\uB974\uB2E4\uACE0 \uC801\uC774 \uB418\uB294 \uAC74 \uC544\uB2C8\uC796\uC544\n\uC11C\uB85C
    \uC874\uC911\uD558\uBA74\uC11C \uC9C0\uB0B4\uB294 \uAC8C \uACB0\uAD6D \uC81C\uC77C
    \uC774\uB4DD\uC784"
