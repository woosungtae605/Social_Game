  m_Name: 1_D
  m_EditorClassIdentifier: Assembly-CSharp::Team.KYR.Scripts.BoardPostContentSo
  body: "\uC5B4\uBA38 \uC5B8\uB0D0\uB4E4 \uC544\uC9C1\uB3C4 \uC720\uB9AC\uCC9C\uC7A5
    \uC5C6\uB2E4\uACE0 \uD558\uB294 \uC0AC\uB78C\uB4E4 \uC788\uAE14? \u314B\u314B\u314B
    \uAC19\uC740 \uB2A5\uB825\uC73C\uB85C \uB4E4\uC5B4\uAC00\uB3C4 \uC2B9\uC9C4\uC774\uB098
    \uD575\uC2EC \uC5C5\uBB34\uC5D0\uC11C \uB0A8\uC790\uAC00 \uB354 \uC720\uB9AC\uD55C
    \uACBD\uC6B0\uAC00 \uC788\uB294\uB370 \uBB34\uC870\uAC74 \uAC1C\uC778 \uB2A5\uB825
    \uBD80\uC871\uC774\uB77C\uACE0 \uD558\uB294 \uAC70 \uC9C4\uC9DC \uB2F5\uB2F5\uD558\uAE14.
    \uAC89\uC73C\uB85C\uB294 \uACF5\uC815\uD55C \uACBD\uC7C1\uC774\uB77C\uACE0 \uD574\uB193\uACE0
    \uC870\uC9C1 \uBD84\uC704\uAE30\uB098 \uC624\uB798\uB41C \uAD00\uD589 \uB54C\uBB38\uC5D0
    \uC5EC\uC790\uB4E4\uC774 \uC704\uB85C \uC62C\uB77C\uAC00\uAE30 \uC5B4\uB824\uC6B4
    \uAD6C\uC870\uAC00 \uB0A8\uC544 \uC788\uB294 \uAC83\uB3C4 \uD604\uC2E4\uC778\uB370
    \uADF8\uAC78 \uC804\uBD80 \uAC1C\uC778 \uD0D3\uC73C\uB85C \uB3CC\uB9AC\uBA74
    \uBB38\uC81C\uAC00 \uD574\uACB0\uB418\uACA0\uB0D0\uAD6C\uC694;;"
