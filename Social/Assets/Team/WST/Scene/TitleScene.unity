  m_Script: {fileID: 11500000, guid: 35ca9b9f62bfb824192c24c32d00f5a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Team.WST.Scripts.Title.TitleNewsTicker
  tickerText: {fileID: 841349854}
  pixelsPerSecond: 90
  headlines:
  - "\uC18D\uBCF4 \xB7 \uD55C\uAD6D \uBB38\uD654, \uBD81\uBBF8 \uC0C1\uB959. \uD604\uC9C0
    \uCDE8\uD5A5 \uAC10\uC5FC\uB960 \uAE09\uC0C1\uC2B9"
  - "CULTURE CORP. \uBD84\uAE30 \uBCF4\uACE0 \xB7 \uB3D9\uC544\uC2DC\uC544 \uC804\uC120
    \uC548\uC815, \uC11C\uAD6C \uD655\uC0B0\uC744 \uAD8C\uACE0\uD569\uB2C8\uB2E4"
  - "\uACBD\uACE0 \xB7 \uC790\uAD6D \uBB38\uD654 \uC800\uD56D \uAC10\uC9C0. \uACA9\uB9AC\uD558\uC9C0
    \uB9D0\uACE0 \uD2B8\uB80C\uB4DC\uB97C \uD22C\uC785\uD558\uC138\uC694"
  - "LIVE \xB7 \uC77C\uBCF8\uC5D0\uC11C K-\uCF58\uD150\uCE20 \uB300\uD655\uC0B0.
    \uBB38\uD654\uB825 \uD504\uB85C\uD1A0\uCF5C \uAC00\uB3D9"
  - "\uC778\uC0AC\uB9D0 \xB7 \uC624\uB298\uB3C4 \uC138\uACC4\uB97C \uCDE8\uD5A5\uC73C\uB85C
    \uBB3C\uB4E4\uC77C \uC900\uBE44 \uB418\uC168\uC2B5\uB2C8\uAE4C"
